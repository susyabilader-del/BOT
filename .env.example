# Telegram Bot Token (@BotFather'dan alınır)
BOT_TOKEN=your_bot_token_here

# Telegram API credentials (https://my.telegram.org adresinden alınır)
API_ID=your_api_id_here
API_HASH=your_api_hash_here

# Bot admin kullanıcı ID'si (sadece bu kişi komut verebilir)
ADMIN_USER_ID=your_telegram_user_id

# Bayi/SAHA grupları (virgülle ayrılmış ID listesi - taleplerin geldiği yer)
SOURCE_GROUPS=-5280375965,-5273505390,-4783131107

# Çekim Operasyon / Yatırım Destek grupları (son teyid - virgülle ayrılmış)
VERIFY_GROUPS=-5148876334,-5139869820

# Opsiyonel: Rapor gönderilecek grup/kanal
REPORT_CHANNEL=

# Tarama aralığı (dakika)
SCAN_INTERVAL=5

# Mesaj eşleşme eşiği (0-100 arası, fuzzy matching)
MATCH_THRESHOLD=75
